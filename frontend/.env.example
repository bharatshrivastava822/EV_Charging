# ==============================================================================
# ChargerGo Frontend Environment Configuration
# ==============================================================================

# Backend REST API Base URL
# For local development with Vite proxy: /api
# For production (e.g., Render/Railway/Heroku/AWS backend): https://your-backend-service.com/api
VITE_API_BASE_URL=/api

# Google Maps Platform API Key (Optional)
# Must start with AIzaSy... with Maps JavaScript API enabled and authorized domain restrictions
# If omitted, ChargerGo automatically uses real high-resolution satellite imagery + hybrid road overlays
VITE_GOOGLE_MAPS_API_KEY=
